{
  "name": "sysml-editor",
  "displayName": "SysML Editor",
  "description": "Graphical and model-aware editor for SysML v2",
  "version": "0.0.1",
  "publisher": "your-publisher",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22",
    "vscode": "^1.105.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.sysml",
    "workspaceContains:**/*.kerml"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sysml",
          "title": "SysML",
          "icon": "media/sysml.svg"
        }
      ]
    },
    "views": {
      "sysml": [
        {
          "id": "sysmlModel",
          "name": "SysML Model"
        }
      ]
    }
  },
  "scripts": {
    "typecheck": "npm run generate:parser && tsc --noEmit",
    "build": "npm run generate:parser && node esbuild.mjs",
    "test": "npm run generate:parser && vitest run",
    "test:integration": "npm run build && tsc -p tsconfig.integration.json && node out/test/integration/runTest.js",
    "generate:parser": "antlr-ng -Dlanguage=TypeScript -v -o src/parser/generated --lib vendor/sysml-v2-grammar vendor/sysml-v2-grammar/SysMLv2Lexer.g4 vendor/sysml-v2-grammar/SysMLv2Parser.g4",
    "generate:dfa": "npm run generate:parser && tsx scripts/generate-dfa-snapshot.ts",
    "bench:parser": "npm run generate:parser && tsx scripts/parser-bench.ts",
    "gate:parser": "npm run generate:parser && tsx scripts/parser-gate.ts",
    "gate:parser:record": "npm run generate:parser && tsx scripts/parser-gate.ts --write"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.105.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "antlr-ng": "^1.0.10",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "antlr4ng": "^3.0.16"
  }
}
